# 复制为 .env 后填写。不要提交、不要发给别人。

# Docker 部署用：docker compose 拉的镜像名。GitHub Actions 推到 ghcr.io/<你的 GitHub 账号小写>/c5bot
# 回滚就把 latest 换成版本号（如 0.1.0）或 Actions 日志里的 sha-xxxxxxx 标签，再跑 upgrade
# C5BOT_IMAGE=ghcr.io/你的账号/c5bot:latest

# C5GAME 官网 -> 个人中心 -> API 管理 申请。等同于账号凭证，泄露后别人可以直接用你的余额下单
C5_APP_KEY=

# 收货 Steam 账号的交易链接（Steam -> 库存 -> 交易报价 -> 谁能向我发送交易报价 -> 最下面）
# C5_TRADE_URL=https://steamcommunity.com/tradeoffer/new/?partner=123456&token=abcdefgh

# dry：只监控，到价后模拟买入并记账，不花钱
# live：真实下单，另外必须写 C5_LIVE_CONFIRM=yes、C5_TRADE_URL、C5_MAX_TOTAL_SPEND
C5_MODE=dry
# C5_LIVE_CONFIRM=yes

# listing：到价后查在售列表，按在售 id 批量买（在售接口是内测接口，需要在官网把本机公网 IP 加进白名单）
# quick：到价后调“快速购买”，平台挑最低价，一次一件（不需要在售接口）
C5_STRATEGY=listing

# 风控
# 所有饰品累计花费上限，实盘必填
C5_MAX_TOTAL_SPEND=500
# 每轮最多下几单
C5_MAX_BUY_PER_CYCLE=10
# 账户余额至少留这么多不动
C5_MIN_BALANCE_RESERVE=0
# 某个饰品下单被拒后暂停多少秒
C5_ERROR_COOLDOWN_SEC=10

# 轮询间隔（秒）。平台默认限流 50 qps，每轮只发 1 个行情请求，到价才会多发
C5_POLL_INTERVAL_SEC=3
C5_TIMEOUT_SEC=10

# 代理（可选）。注意：在售接口校验 IP 白名单，走代理时白名单要填代理的出口 IP
# C5_PROXY=http://127.0.0.1:7890

# 访问 Steam 市场用的代理（可选，跟 C5 分开配）和 Steam 钱包币种（23 = 人民币）。
# 推荐轮转住宅代理：每个请求换一个出口 IP，Steam 按 IP 的限流就不再是问题，http 和 socks5 都行，账号密码写在地址里。
# 只有行情、成交历史、汇率走它；看板上登录 Steam 和续期直连（多步流程换 IP 容易被判异常，令牌本身不绑 IP）。
# STEAM_PROXY=http://用户名:密码@proxy.example.com:1337
# 你卖货的 Steam 账号是哪个区：23 人民币区，1 美元区。美元区时看板全部按美元算，“折”变成直接的汇率（人民币 / 1 美元），不再量 Steam 汇率
STEAM_CURRENCY=23
# 看板多久刷新一次 Steam 价（秒）。Steam 对未登录请求限流严，别低于 60 × 箱子数。
# 被 429 后 5 分钟内不再请求 Steam（连续被限翻倍，最多 1 小时），期间沿用旧价。云服务器 IP 更容易被限，频繁 429 就配 STEAM_PROXY 换出口
STEAM_REFRESH_SEC=600
# 量 Steam 人民币/美元换算率（看板上的“Steam 汇率”）用的参照饰品，Steam 市场英文名。
# 要贵：Steam 换算后向上取整到分，几十美元的饰品误差 0.03% 以内，几毛钱的箱子会差百分之几
# STEAM_RATE_ITEM=AK-47 | Redline (Field-Tested)
# 在看板上登录 Steam 后，挂单价按最近几天的成交历史算，净到手、折扣、目标价都按它算：
# 把窗口内每小时的成交按价从高到低累计成交量，累计到总量的 STEAM_SELL_VOLUME_SHARE 比例时的那个价就是挂单价。
# 0.3 = 最近几天有 30% 的成交是在这个价或更高价成交的，挂上去能走；调小价更高但要排队，调大更稳，1 = 窗口内最低价
STEAM_SELL_WINDOW_DAYS=3
STEAM_SELL_VOLUME_SHARE=0.3

# 网页看板，run 时自动启动，浏览器打开 http://127.0.0.1:8766。C5_UI_PORT=0 关闭
# C5_UI_HOST=127.0.0.1
# C5_UI_PORT=8766
# 启动时先暂停扫货只看行情，在看板上点“继续扫货”才开始买（等同于 run --paused）
# C5_START_PAUSED=yes

# 数据目录，存 sqlite 流水和日志，默认 ./data
# C5_DATA_DIR=./data
C5_LOG_LEVEL=INFO
